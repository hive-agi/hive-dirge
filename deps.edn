{:paths ["src" "resources"]
 :deps {org.clojure/clojure {:mvn/version "1.12.6"}

        ;; IAddon contract (leaf lib). hive-dirge depends on the contract,
        ;; never on a host: no hive-mcp.* anywhere.
        io.github.hive-agi/hive-addon {:mvn/version "1.0.14"}

        ;; Result monad / rescue DSL, same pin as hive-addon.
        io.github.hive-agi/hive-dsl {:mvn/version "0.5.31"}

        ;; hive.dirge.host: the :json dialect, registry and SSE executor.
        io.github.hive-agi/hive-vessel {:mvn/version "0.1.14"}

        ;; hive.olympus.dirge: the manifest's init-ns is hive-olympus.harness.
        io.github.hive-agi/hive-olympus {:mvn/version "0.1.11"}

        ;; hive-dirge.ling.process: ACP JSON-RPC frames on stdio.
        org.clojure/data.json {:mvn/version "2.5.2"}}

 :aliases
 {;; Work against sibling checkouts instead of the released jars.
  :dev  {:extra-paths ["dev" "test"]
         :override-deps {io.github.hive-agi/hive-addon   {:local/root "../hive-addon"}
                         io.github.hive-agi/hive-vessel  {:local/root "../hive-vessel"}
                         io.github.hive-agi/hive-olympus {:local/root "../hive-olympus"}}}

  :test {:extra-paths ["test"]
         :extra-deps  {io.github.cognitect-labs/test-runner
                       {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                       org.clojure/test.check {:mvn/version "1.1.3"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test
         :jvm-opts ["-Xmx1g"]}
  :build {:deps {io.github.hive-agi/hive-build {:mvn/version "0.1.25"}}
          :jvm-opts ["-Xmx1g"]
          :ns-default hive-build.api}
  :doctor {:main-opts ["-m" "hive-dirge.doctor"]}}}
